{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": ["${mod_authors}"],
    "license": "${mod_license}",
    "environment": "*",
    "entrypoints": {
        "client": ["com.example.examplemod.ExampleModClient"]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=25",
        "vellum": ">=${vellum_version}"
    }
}
