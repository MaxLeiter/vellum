+package org.mozilla.javascript.tests.es6;
+
+import org.junit.jupiter.api.Test;
+import org.mozilla.javascript.testutils.Utils;
+
+/** Spread arguments in calls and new expressions. */
+public class SpreadCallTest {
+
+    @Test
+    public void spreadIntoBuiltIn() {
+        Utils.assertWithAllModes_ES6(5, "Math.max(...[1, 5, 3])");
+    }
+
+    @Test
+    public void spreadMixedWithArguments() {
+        Utils.assertWithAllModes_ES6(
+                "1,2,3,4,5",
+                "function f() { return Array.prototype.join.call(arguments); }\n"
+                        + "var a = [1, 2], c = [4, 5];\n"
+                        + "f(...a, 3, ...c)");
+    }
+
+    @Test
+    public void spreadIntoInterpretedFunction() {
+        Utils.assertWithAllModes_ES6(
+                "a-b-undefined",
+                "function f(x, y, z) { return x + '-' + y + '-' + z; } f(...['a', 'b'])");
+    }
+
+    @Test
+    public void spreadIntoMethodKeepsThis() {
+        Utils.assertWithAllModes_ES6(
+                6,
+                "var o = { k: 1, m(a, b, c) { return this.k * (a + b + c); } }; o.m(...[1, 2, 3])");
+    }
+
+    @Test
+    public void spreadIntoRestParameter() {
+        Utils.assertWithAllModes_ES6(
+                3, "function f(first, ...rest) { return rest.length; } f(...[0, 1, 2, 3])");
+    }
+
+    @Test
+    public void spreadIterables() {
+        Utils.assertWithAllModes_ES6(
+                "a,b,1,2",
+                "function f() { return Array.from(arguments).join(); }\n"
+                        + "f(...'ab', ...new Set([1, 2]))");
+        Utils.assertWithAllModes_ES6(
+                3,
+                "function* g() { yield 1; yield 2; } "
+                        + "function f(a, b) { return a + b; } f(...g())");
+    }
+
+    @Test
+    public void spreadEvaluationOrder() {
+        Utils.assertWithAllModes_ES6(
+                "f,a,b",
+                "var log = [];\n"
+                        + "function f() { log.push('f'); return function() {}; }\n"
+                        + "function a() { log.push('a'); return [1]; }\n"
+                        + "function b() { log.push('b'); return [2]; }\n"
+                        + "f()(...a(), ...b()); log.join()");
+    }
+
+    @Test
+    public void spreadIntoNew() {
+        Utils.assertWithAllModes_ES6(2020, "var d = new Date(...[2020, 1, 1]); d.getFullYear()");
+        Utils.assertWithAllModes_ES6(
+                "3:4",
+                "function P(x, y) { this.x = x; this.y = y; }\n"
+                        + "var p = new P(...[3, 4]); p.x + ':' + p.y");
+    }
+
+    @Test
+    public void spreadWithApplyAndCall() {
+        Utils.assertWithAllModes_ES6(
+                "1,2,3",
+                "function f() { return Array.from(arguments).join(); }\n"
+                        + "f.call(null, ...[1, 2, 3])");
+        Utils.assertWithAllModes_ES6(
+                "1,2",
+                "function f() { return Array.from(arguments).join(); }\n"
+                        + "f.apply(null, ...[[1, 2]])");
+    }
+
+    @Test
+    public void spreadOfNonIterableThrows() {
+        Utils.assertEcmaErrorES6("TypeError", "function f() {} f(...1)");
+    }
+
+    @Test
+    public void optionalCallWithSpread() {
+        Utils.assertWithAllModes_ES6(
+                "undefined,3",
+                "var o = null, p = { f(a, b) { return a + b; } };\n"
+                        + "[o?.f(...[1, 2]), p.f?.(...[1, 2])].map(String).join()");
+    }
+
+    @Test
+    public void emptySpread() {
+        Utils.assertWithAllModes_ES6(0, "function f() { return arguments.length; } f(...[])");
+    }
+
+    @Test
+    public void spreadIsSyntaxErrorBeforeEs6() {
+        Utils.assertEvaluatorException_1_8("syntax error (test#1)", "Math.max(...[1, 2])");
+    }
+}
