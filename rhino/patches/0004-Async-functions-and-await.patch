+    /**
+     * Calls an async function: {@code body} starts it, and returns the generator that its code
+     * compiles to, which yields the values it awaits. Returns the promise of its result.
+     */
+    static Object runAsyncFunction(Context cx, Scriptable scope, Supplier<Object> body) {
+        Scriptable top = ScriptableObject.getTopLevelScope(scope);
+        Capability cap =
+                new Capability(
+                        cx, top, TopLevel.getBuiltinCtor(cx, top, TopLevel.Builtins.Promise));
+        Object generator;
+        try {
+            generator = body.get();
+        } catch (RhinoException re) {
+            cap.reject.call(
+                    cx,
+                    top,
+                    Undefined.SCRIPTABLE_UNDEFINED,
+                    new Object[] {getErrorObject(cx, top, re)});
+            return cap.promise;
+        }
+        new AsyncFunctionRun(top, (ES6Generator) generator, cap)
+                .step(cx, false, Undefined.instance);
+        return cap.promise;
+    }
+
+    /** The run of an async function, which steps its generator as awaited values settle. */
+    private static final class AsyncFunctionRun {
+        private final Scriptable scope;
+        private final ES6Generator generator;
+        private final Capability capability;
+        private final Callable onFulfilled;
+        private final Callable onRejected;
+
+        AsyncFunctionRun(Scriptable scope, ES6Generator generator, Capability capability) {
+            this.scope = scope;
+            this.generator = generator;
+            this.capability = capability;
+            onFulfilled =
+                    new LambdaFunction(
+                            scope,
+                            1,
+                            (Context cx, Scriptable s, Scriptable thisObj, Object[] args) -> {
+                                step(cx, false, args.length > 0 ? args[0] : Undefined.instance);
+                                return Undefined.instance;
+                            });
+            onRejected =
+                    new LambdaFunction(
+                            scope,
+                            1,
+                            (Context cx, Scriptable s, Scriptable thisObj, Object[] args) -> {
+                                step(cx, true, args.length > 0 ? args[0] : Undefined.instance);
+                                return Undefined.instance;
+                            });
+        }
+
+        /** Resumes the function with the outcome of what it awaited, up to its next await. */
+        void step(Context cx, boolean rejected, Object value) {
+            if (!ScriptRuntime.hasTopCall(cx)) {
+                // a microtask run after the script that started it
+                ScriptRuntime.doTopCall(
+                        (Context c, Scriptable s, Scriptable thisObj, Object[] args) -> {
+                            step(c, rejected, value);
+                            return Undefined.instance;
+                        },
+                        cx,
+                        scope,
+                        Undefined.SCRIPTABLE_UNDEFINED,
+                        ScriptRuntime.emptyArgs,
+                        false);
+                return;
+            }
+            Scriptable result;
+            try {
+                result =
+                        rejected
+                                ? generator.resumeThrow(cx, scope, value)
+                                : generator.resume(cx, scope, value);
+            } catch (RhinoException re) {
+                capability.reject.call(
+                        cx,
+                        scope,
+                        Undefined.SCRIPTABLE_UNDEFINED,
+                        new Object[] {getErrorObject(cx, scope, re)});
+                return;
+            }
+            Object resultValue = ScriptableObject.getProperty(result, ES6Iterator.VALUE_PROPERTY);
+            if (resultValue == Scriptable.NOT_FOUND) {
+                resultValue = Undefined.instance;
+            }
+            if (ScriptRuntime.isIteratorDone(cx, result)) {
+                capability.resolve.call(
+                        cx, scope, Undefined.SCRIPTABLE_UNDEFINED, new Object[] {resultValue});
+                return;
+            }
+            await(cx, resultValue);
+        }
+
+        /**
+         * Awaits {@code value}: resolves it to a promise as {@code Promise.resolve} does, then
+         * resumes the function from a reaction job once that settles.
+         */
+        private void await(Context cx, Object value) {
+            Object promise;
+            try {
+                promise =
+                        resolveInternal(
+                                cx,
+                                scope,
+                                TopLevel.getBuiltinCtor(cx, scope, TopLevel.Builtins.Promise),
+                                value);
+            } catch (RhinoException re) {
+                step(cx, true, getErrorObject(cx, scope, re));
+                return;
+            }
+            NativePromise p = (NativePromise) promise;
+            Reaction fulfill = new Reaction(null, ReactionType.FULFILL, onFulfilled);
+            Reaction reject = new Reaction(null, ReactionType.REJECT, onRejected);
+            if (p.state == State.PENDING) {
+                p.fulfillReactions.add(fulfill);
+                p.rejectReactions.add(reject);
+            } else if (p.state == State.FULFILLED) {
+                Object result = p.result;
+                cx.enqueueMicrotask(() -> fulfill.invoke(cx, scope, result));
+            } else {
+                Object result = p.result;
+                p.markHandled(cx);
+                cx.enqueueMicrotask(() -> reject.invoke(cx, scope, result));
+            }
+        }
+    }
+
