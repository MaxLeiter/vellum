From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Max Leiter <8675906+MaxLeiter@users.noreply.github.com>
Date: Mon, 5 Oct 2026 17:47:05 -0700
Subject: [PATCH] Size limit on BigInt arithmetic and parsing

A single BigInteger multiplication, power, shift or parse runs in Java,
out of sight of the instruction observer, and its cost grows faster than
its operands. VellumBigInts checks the size of each result first and
throws a RangeError past VellumBigInts.setMaxBits. The limit is
process-wide and unlimited by default.

diff --git a/rhino/src/main/java/org/mozilla/javascript/NativeBigInt.java b/rhino/src/main/java/org/mozilla/javascript/NativeBigInt.java
index 30edaff79f3b..1719f98d4dc2 100644
--- a/rhino/src/main/java/org/mozilla/javascript/NativeBigInt.java
+++ b/rhino/src/main/java/org/mozilla/javascript/NativeBigInt.java
@@ -101,7 +101,7 @@ final class NativeBigInt extends ScriptableObject {
             return BigInteger.ZERO;
         }
 
-        BigInteger modulus = BigInteger.ONE.shiftLeft(bits); // 2^bits
+        BigInteger modulus = VellumBigInts.shiftLeft(BigInteger.ONE, bits); // 2^bits
 
         if (isSigned) {
             return asSignedN(bigInt, bits, modulus);
@@ -124,7 +124,7 @@ final class NativeBigInt extends ScriptableObject {
 
     private static BigInteger asSignedN(BigInteger bigInt, int bits, BigInteger modulus) {
         // For signed: use two's complement representation
-        BigInteger halfModulus = BigInteger.ONE.shiftLeft(bits - 1); // 2^(bits-1)
+        BigInteger halfModulus = VellumBigInts.shiftLeft(BigInteger.ONE, bits - 1); // 2^(bits-1)
         BigInteger minValue = halfModulus.negate(); // -2^(bits-1)
         BigInteger maxValue = halfModulus.subtract(BigInteger.ONE); // 2^(bits-1) - 1
 
