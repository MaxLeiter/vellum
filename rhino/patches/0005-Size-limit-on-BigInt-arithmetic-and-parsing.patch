+                        return VellumBigInts.parse(s.substring(start + 2, end + 1), radix);
                     } catch (NumberFormatException ex) {
                         throw syntaxErrorById("msg.bigint.bad.form");
                     }
@@ -819,7 +819,7 @@ public class ScriptRuntime {
             throw syntaxErrorById("msg.bigint.bad.form");
         }
         try {
-            return new BigInteger(sub);
