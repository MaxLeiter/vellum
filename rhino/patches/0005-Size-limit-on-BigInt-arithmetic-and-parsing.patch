     public static Number multiply(Number val1, Number val2) {
         if (val1 instanceof BigInteger && val2 instanceof BigInteger) {
-            return ((BigInteger) val1).multiply((BigInteger) val2);
+            return VellumBigInts.multiply((BigInteger) val1, (BigInteger) val2);
         } else if (val1 instanceof BigInteger || val2 instanceof BigInteger) {
             throw ScriptRuntime.typeErrorById("msg.cant.convert.to.number", "BigInt");
         } else if (val1 instanceof Integer && val2 instanceof Integer) {
@@ -3856,7 +3856,7 @@ public class ScriptRuntime {
 
             try {
                 int intVal2 = ((BigInteger) val2).intValueExact();
-                return ((BigInteger) val1).pow(intVal2);
+                return VellumBigInts.pow((BigInteger) val1, intVal2);
             } catch (ArithmeticException e) {
                 // This is outside the scope of the ECMA262 specification.
                 throw ScriptRuntime.rangeErrorById("msg.bigint.out.of.range.arithmetic");
@@ -3930,7 +3930,7 @@ public class ScriptRuntime {
         if (val1 instanceof BigInteger && val2 instanceof BigInteger) {
             try {
                 int intVal2 = ((BigInteger) val2).intValueExact();
-                return ((BigInteger) val1).shiftLeft(intVal2);
+                return VellumBigInts.shiftLeft((BigInteger) val1, intVal2);
             } catch (ArithmeticException e) {
                 // This is outside the scope of the ECMA262 specification.
                 throw ScriptRuntime.rangeErrorById("msg.bigint.out.of.range.arithmetic");
@@ -3956,7 +3956,7 @@ public class ScriptRuntime {
         if (val1 instanceof BigInteger && val2 instanceof BigInteger) {
             try {
                 int intVal2 = ((BigInteger) val2).intValueExact();
-                return ((BigInteger) val1).shiftRight(intVal2);
+                return VellumBigInts.shiftRight((BigInteger) val1, intVal2);
             } catch (ArithmeticException e) {
                 // This is outside the scope of the ECMA262 specification.
                 throw ScriptRuntime.rangeErrorById("msg.bigint.out.of.range.arithmetic");
diff --git a/rhino/src/main/java/org/mozilla/javascript/TokenStream.java b/rhino/src/main/java/org/mozilla/javascript/TokenStream.java
index 45f9b91d6e4d..d5a0d487445d 100644
--- a/rhino/src/main/java/org/mozilla/javascript/TokenStream.java
+++ b/rhino/src/main/java/org/mozilla/javascript/TokenStream.java
@@ -963,7 +963,7 @@ class TokenStream implements Parser.CurrentPositionReporter {
                 }
 
                 if (isBigInt) {
-                    this.bigInt = new BigInteger(numString, base);
+                    this.bigInt = VellumBigInts.parse(numString, base);
                     return Token.BIGINT;
                 }
 
diff --git a/rhino/src/main/java/org/mozilla/javascript/VellumBigInts.java b/rhino/src/main/java/org/mozilla/javascript/VellumBigInts.java
new file mode 100644
index 000000000000..f711a19aaf96
--- /dev/null
+++ b/rhino/src/main/java/org/mozilla/javascript/VellumBigInts.java
@@ -0,0 +1,66 @@
+/* -*- Mode: java; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 4 -*-
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.javascript;
+
+import java.math.BigInteger;
+
+/**
+ * Size checks for BigInt arithmetic. A single BigInteger operation runs in Java, out of sight of
+ * the instruction observer, and its cost grows faster than its operands: squaring a value 30 times,
+ * or {@code 1n << 2n ** 30n}, would take minutes or exhaust the heap. Every BigInt multiplication,
+ * power, shift and parse from text goes through here first, and results larger than {@link
+ * #maxBits} throw a RangeError.
+ */
+public final class VellumBigInts {
+    /** The largest BigInt, in bits; process-wide, and unlimited unless an embedding sets it. */
+    private static volatile long maxBits = Long.MAX_VALUE;
+
+    private VellumBigInts() {}
+
+    public static void setMaxBits(long bits) {
+        maxBits = bits;
+    }
+
+    public static long maxBits() {
+        return maxBits;
+    }
+
+    private static void check(long bits) {
+        if (bits > maxBits)
+            throw ScriptRuntime.rangeError("BigInt larger than " + maxBits + " bits");
+    }
+
+    public static BigInteger multiply(BigInteger a, BigInteger b) {
+        check((long) a.bitLength() + b.bitLength());
+        return a.multiply(b);
+    }
+
+    public static BigInteger pow(BigInteger a, int exponent) {
+        if (a.abs().compareTo(BigInteger.ONE) > 0) check((long) (a.bitLength() - 1) * exponent + 1);
+        return a.pow(exponent);
+    }
+
+    public static BigInteger shiftLeft(BigInteger a, int n) {
+        if (n > 0 && a.signum() != 0) check((long) a.bitLength() + n);
+        return a.shiftLeft(n);
+    }
+
+    public static BigInteger shiftRight(BigInteger a, int n) {
+        if (n < 0 && a.signum() != 0) check((long) a.bitLength() - (long) n);
+        return a.shiftRight(n);
+    }
+
+    /** Parses {@code text} in {@code radix}; parsing is quadratic in the number of digits. */
+    public static BigInteger parse(String text, int radix) {
+        check((long) Math.ceil(text.length() * (Math.log(Math.max(2, radix)) / Math.log(2))));
+        return new BigInteger(text, radix);
+    }
+
+    public static BigInteger parse(String text) {
+        return parse(text, 10);
+    }
+}
