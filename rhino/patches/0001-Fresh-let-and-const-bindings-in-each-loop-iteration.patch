+    private static class DoEnterBlock extends InstructionClass {
+        @Override
+        NewState execute(Context cx, CallFrame frame, InterpreterState state, int op) {
+            Object bindings = frame.stack[state.stackTop];
+            frame.scope = ScriptRuntime.enterBlockScope(bindings, state.stringReg, cx, frame.scope);
+            state.stackTop--;
+            return null;
+        }
+    }
+
+    private static class DoCopyBlock extends InstructionClass {
+        @Override
+        NewState execute(Context cx, CallFrame frame, InterpreterState state, int op) {
+            frame.scope = ScriptRuntime.copyBlockScope(frame.scope);
+            return null;
+        }
+    }
