+    /**
+     * For a for-in or for-of loop whose head declares let or const bindings, makes the block that
+     * each iteration runs in, and moves the bindings there, so that every iteration has its own.
+     * Returns null when the bindings stay with the loop.
+     */
+    private Scope createIterationScope(Node loop, int declType) {
+        if ((declType != Token.LET && declType != Token.CONST)
+                || parser.compilerEnv.getLanguageVersion() < Context.VERSION_ES6
+                || !(loop instanceof ForInLoop)
+                || loop instanceof ArrayComprehensionLoop) {
+            return null;
+        }
+        Scope loopScope = (Scope) loop;
+        Scope iteration = parser.createScopeNode(Token.BLOCK, loop.getLineno(), loop.getColumn());
+        if (loopScope.getSymbolTable() != null) {
+            // a destructuring head declares its names later, in the new scope
+            Scope.joinScopes(loopScope, iteration);
+            loopScope.setSymbolTable(null);
+        }
+        List<Scope> children = loopScope.getChildScopes();
+        List<Scope> moved = children == null ? List.of() : new ArrayList<>(children);
+        if (children != null) children.clear();
+        loopScope.addChildScope(iteration);
+        for (Scope child : moved) {
+            iteration.addChildScope(child);
+        }
+        return iteration;
+    }
+
