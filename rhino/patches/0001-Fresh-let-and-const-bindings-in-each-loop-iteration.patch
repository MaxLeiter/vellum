From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Max Leiter <8675906+MaxLeiter@users.noreply.github.com>
Date: Mon, 5 Oct 2026 17:10:40 -0700
Subject: [PATCH] Fresh let and const bindings in each loop iteration

From ES6 on, const is block scoped like let, and for, for-in and
for-of heads may declare const.

Closures made in a loop now see the binding of their own iteration:

- for (let ...; ...; ...) copies its block scope before the first test
  and before each increment, when the loop contains a function or a
  call to eval;
- a let or const head of a for-in or for-of loop is bound in a block of
  its own for each iteration.

Without closures the bindings live in local variables. There, a let
without initializer is set to undefined each time its declaration runs,
and a block scoped const is an ordinary variable, so a loop body sees a
fresh value on each pass.

Block scopes whose bindings live in an object now use BlockScope. Its
object has no prototype, so names such as valueOf no longer resolve to
Object.prototype members, and a function called through a block binding
gets the global object as this, as it would from an activation.

A var or function declared in a block nested in one that declares the
same name with let or const is a SyntaxError.

diff --git a/rhino/src/main/java/org/mozilla/javascript/BlockScope.java b/rhino/src/main/java/org/mozilla/javascript/BlockScope.java
new file mode 100644
index 000000000000..767618325b23
--- /dev/null
+++ b/rhino/src/main/java/org/mozilla/javascript/BlockScope.java
@@ -0,0 +1,61 @@
+/* -*- Mode: java; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 4 -*-
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.javascript;
+
+/**
+ * The scope of a block that declares let, const or class bindings, when they cannot be kept in
+ * local variables. It works like a {@code with} scope over an object holding the bindings, except
+ * that the object has no prototype, so names such as {@code toString} are not found in it, and a
+ * function called through one of its bindings does not get the object as {@code this}.
+ */
+final class BlockScope extends NativeWith {
+    private static final long serialVersionUID = 1L;
+
+    BlockScope(Scriptable parent, Scriptable bindings) {
+        super(parent, bindings);
+    }
+
+    @Override
+    public String getClassName() {
+        return "Block";
+    }
+
+    /**
+     * Enters a block scope over {@code bindings}, an object literal holding the block's bindings.
+     * The names in {@code constNames}, separated by spaces, become uninitialized constants.
+     */
+    static Scriptable enter(Object bindings, String constNames, Scriptable parent) {
+        ScriptableObject obj = (ScriptableObject) bindings;
+        obj.setPrototype(null);
+        if (!constNames.isEmpty()) {
+            for (String name : constNames.split(" ", -1)) {
+                obj.delete(name);
+                obj.defineConst(name, obj);
+            }
+        }
+        return new BlockScope(parent, obj);
+    }
+
+    /** Makes a block scope with the same parent and a copy of this scope's bindings. */
+    BlockScope copy() {
+        ScriptableObject from = (ScriptableObject) getPrototype();
+        NativeObject to = new NativeObject();
+        to.setParentScope(from.getParentScope());
+        for (Object id : from.getAllIds()) {
+            String name = (String) id;
+            int attributes = from.getAttributes(name);
+            Object value = from.get(name, from);
+            if ((attributes & ScriptableObject.UNINITIALIZED_CONST) != 0) {
+                to.defineConst(name, to);
+            } else {
+                to.defineProperty(name, value, attributes);
+            }
+        }
+        to.setPrototype(null);
+        return new BlockScope(getParentScope(), to);
+    }
+}
