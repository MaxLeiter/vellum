+                        + "[c.get('a'), c instanceof Map].join()");
+    }
+
+    @Test
+    public void extendsPlainFunction() {
+        check(
+                "1,2,true",
+                "function P(a) { this.a = a; } P.prototype.getA = function() { return this.a; };\n"
+                        + "class C extends P { constructor() { super(1); this.b = 2; } }\n"
+                        + "var c = new C(); [c.getA(), c.b, c instanceof P].join()");
+    }
+
+    @Test
+    public void newTarget() {
+        check(
+                "A,B",
+                "var seen = [];\n"
+                        + "class A { constructor() { seen.push(new.target.name); } }\n"
+                        + "class B extends A {}\n"
+                        + "new A(); new B(); seen.join()");
+    }
+
+    @Test
+    public void arrowFunctionsInConstructor() {
+        check(
+                "1:1",
+                "class A { constructor() { var f = () => this; this.v = 1; this.f = f; } }\n"
+                        + "class B extends A { constructor() { var g = () => super(); g(); this.w = this.v; } }\n"
+                        + "var b = new B(); b.w + ':' + b.f().v");
+    }
+
+    @Test
+    public void callingClassWithoutNewThrows() {
+        Utils.assertEcmaErrorES6(
+                "TypeError: Class constructor A cannot be invoked without 'new'", "class A {} A()");
+    }
+
+    @Test
+    public void thisBeforeSuperThrows() {
+        Utils.assertEcmaErrorES6(
+                "ReferenceError: Must call super constructor in derived class before accessing"
+                        + " 'this'",
+                "class A {} class B extends A { constructor() { this.x = 1; super(); } } new B()");
+    }
+
+    @Test
+    public void missingSuperThrows() {
+        Utils.assertEcmaErrorES6(
+                "ReferenceError: Derived constructor B must call super() before it returns",
+                "class A {} class B extends A { constructor() {} } new B()");
+    }
+
+    @Test
+    public void superTwiceThrows() {
+        Utils.assertEcmaErrorES6(
+                "ReferenceError: Super constructor may only be called once",
+                "class A {} class B extends A { constructor() { super(); super(); } } new B()");
+    }
+
+    @Test
+    public void constructorMayReturnAnObject() {
+        check(1, "class A { constructor() { return { v: 1 }; } } new A().v");
+        check(1, "class A {} class B extends A { constructor() { return { v: 1 }; } } new B().v");
+    }
+
+    @Test
+    public void extendsNonConstructorThrows() {
+        Utils.assertEcmaErrorES6(
+                "TypeError: Class extends value 1 is not a constructor or null",
+                "class A extends 1 {}");
+    }
+
+    @Test
+    public void superCallOutsideDerivedConstructorIsSyntaxError() {
+        Utils.assertEvaluatorExceptionES6(
+                "super(...) is only valid in the constructor of a derived class",
+                "class A { constructor() { super(); } }");
+        Utils.assertEvaluatorExceptionES6(
+                "super should be inside a shorthand function",
+                "class A extends Object { m() { super(); } }");
+    }
+
+    @Test
+    public void classBodyIsStrict() {
+        Utils.assertEcmaErrorES6(
+                "ReferenceError: Assignment to undefined \"undeclared\" in strict mode",
+                "class A { m() { undeclared = 1; } } new A().m()");
+    }
+
+    @Test
+    public void classIsBlockScoped() {
+        check(
+                "outer",
+                "var r; class A { } { class A { static n() { return 'inner'; } } } "
+                        + "r = typeof A.n === 'undefined' ? 'outer' : 'inner'; r");
+    }
+
+    @Test
+    public void classUsedBeforeDeclarationThrows() {
+        Utils.assertEcmaErrorES6("TypeError", "new A(); class A {}");
+    }
+
+    @Test
+    public void constructorNamedByString() {
+        check(2, "class A { 'constructor'() { this.v = 2; } } new A().v");
+    }
+
+    @Test
+    public void memberNamedStatic() {
+        check(
+                "1,2",
+                "class A { static() { return 1; } static static() { return 2; } }\n"
+                        + "[new A().static(), A.static()].join()");
+    }
+
+    @Test
+    public void methodsCannotBeConstructed() {
+        Utils.assertEcmaErrorES6("TypeError", "class A { m() {} } new (new A().m)()");
+    }
+
+    @Test
+    public void reflectConstructWithClasses() {
+        check(
+                "true,B",
+                "class A { constructor() { this.t = new.target.name; } } class B {}\n"
+                        + "var o = Reflect.construct(A, [], B);\n"
+                        + "[o instanceof B, o.t].join()");
+    }
+
+    @Test
+    public void accessorsAndSuperInClassExpression() {
+        check(
+                "x!",
+                "var Base = class { greet() { return 'x'; } };\n"
+                        + "var D = class extends Base { greet() { return super.greet() + '!'; } };\n"
+                        + "new D().greet()");
+    }
+
+    @Test
+    public void privateNamesAreSyntaxErrors() {
+        Utils.assertEvaluatorExceptionES6(
+                "private class members (#name) are not supported", "class A { #x = 1; }");
+        Utils.assertEvaluatorExceptionES6(
+                "private class members (#name) are not supported",
+                "class A { m() { return this.#x; } }");
+    }
+
+    @Test
+    public void classDeclarationNeedsABlock() {
+        Utils.assertEvaluatorExceptionES6(
+                "a class declaration must be directly in a block", "if (true) class A {}");
+        Utils.assertEvaluatorExceptionES6(
+                "a class declaration must be directly in a block", "label: class A {}");
+    }
+
+    @Test
+    public void toStringOfInstances() {
+        check("[object Object]", "class A {} String(new A())");
+    }
+}
