diff --git a/rhino/src/test/java/org/mozilla/javascript/tests/es6/ClassTest.java b/rhino/src/test/java/org/mozilla/javascript/tests/es6/ClassTest.java
new file mode 100644
index 000000000000..e1ad511a2839
--- /dev/null
+++ b/rhino/src/test/java/org/mozilla/javascript/tests/es6/ClassTest.java
@@ -0,0 +1,367 @@
+/* -*- Mode: java; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 4 -*-
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.javascript.tests.es6;
+
+import org.junit.jupiter.api.Test;
+import org.mozilla.javascript.Context;
+import org.mozilla.javascript.testutils.Utils;
+
+/** Class declarations and expressions. */
+public class ClassTest {
+
+    private static void check(Object expected, String script) {
+        Utils.assertWithAllModes_ES6(expected, script);
+        Utils.assertWithAllModes(Context.VERSION_ECMASCRIPT, null, expected, script);
+        Utils.assertWithAllModes_ES6(
+                expected, "(function() { return eval(" + quote(script) + "); })()");
+    }
+
+    private static String quote(String s) {
+        return "'" + s.replace("\\", "\\\\").replace("'", "\\'").replace("\n", "\\n") + "'";
+    }
+
+    @Test
+    public void declarationWithConstructorAndMethods() {
+        check(
+                "2:3",
+                "class A { constructor(x) { this.x = x; } get y() { return this.x + 1; }"
+                        + " static z() { return 3; } }\n"
+                        + "new A(1).y + ':' + A.z()");
+    }
+
+    @Test
+    public void classExpression() {
+        check("1", "var A = class { m() { return 1; } }; String(new A().m())");
+        check("B", "var A = class B { m() { return B.name; } }; new A().m()");
+        check("A", "var A = class {}; A.name");
+    }
+
+    @Test
+    public void namedClassExpressionSeesItsOwnName() {
+        check(
+                true,
+                "var A = class B { static make() { return new B(); } };"
+                        + " var C = A; A = null; C.make() instanceof C");
+    }
+
+    @Test
+    public void methodsAreNotEnumerable() {
+        check(
+                "x|",
+                "class A { constructor() { this.x = 1; } m() {} get g() { return 1; } static s() {} }\n"
+                        + "var keys = []; for (var k in new A()) keys.push(k);\n"
+                        + "keys.join() + '|' + Object.keys(A).join()");
+    }
+
+    @Test
+    public void prototypeAndConstructorLinks() {
+        check(
+                "true,true,function,false",
+                "class A {}\n"
+                        + "[A.prototype.constructor === A, Object.getPrototypeOf(new A()) === A.prototype,"
+                        + " typeof A, Object.getOwnPropertyDescriptor(A, 'prototype').writable].join()");
+    }
+
+    @Test
+    public void computedNamesAndSymbols() {
+        check(
+                "1,2,3",
+                "var k = 'dyn';\n"
+                        + "class A { [k + 'amic']() { return 1; } static ['s' + 1]() { return 2; }\n"
+                        + "  *[Symbol.iterator]() { yield 3; } }\n"
+                        + "[new A().dynamic(), A.s1(), ...new A()].join()");
+    }
+
+    @Test
+    public void gettersAndSetters() {
+        check(
+                "10:5",
+                "class A { constructor() { this._v = 0; } get v() { return this._v * 2; }"
+                        + " set v(x) { this._v = x; } static get s() { return 5; } }\n"
+                        + "var a = new A(); a.v = 5; a.v + ':' + A.s");
+    }
+
+    @Test
+    public void extendsAndSuper() {
+        check(
+                3,
+                "class A { f() { return 1; } }\n"
+                        + "class B extends A { constructor() { super(); this.k = 2; }"
+                        + " f() { return super.f() + this.k; } }\n"
+                        + "new B().f()");
+    }
+
+    @Test
+    public void superConstructorArguments() {
+        check(
+                "1,2,3",
+                "class A { constructor(...a) { this.a = a; } }\n"
+                        + "class B extends A { constructor(x) { super(x, ...[2, 3]); } }\n"
+                        + "new B(1).a.join()");
+    }
+
+    @Test
+    public void defaultDerivedConstructorPassesArguments() {
+        check(
+                "1,2",
+                "class A { constructor(a, b) { this.v = [a, b]; } }\n"
+                        + "class B extends A {}\n"
+                        + "new B(1, 2).v.join()");
+    }
+
+    @Test
+    public void superPropertyAndStaticSuper() {
+        check(
+                "p:c|sp:sc",
+                "class P { get name() { return 'p'; } static who() { return 'sp'; } }\n"
+                        + "class C extends P { get name() { return super.name + ':c'; }"
+                        + " static who() { return super.who() + ':sc'; } }\n"
+                        + "new C().name + '|' + C.who()");
+    }
+
+    @Test
+    public void superMethodSeesSubclassThis() {
+        check(
+                "B",
+                "class A { who() { return this.constructor.name; } }\n"
+                        + "class B extends A { who() { return super.who(); } }\n"
+                        + "new B().who()");
+    }
+
+    @Test
+    public void superInObjectLiteralMethods() {
+        check(
+                "base+lit",
+                "var base = { f() { return 'base'; } };\n"
+                        + "var lit = { __proto__: base, f() { return super.f() + '+lit'; } };\n"
+                        + "lit.f()");
+    }
+
+    @Test
+    public void staticInheritance() {
+        check(
+                "1:true",
+                "class A { static one() { return 1; } } class B extends A {}\n"
+                        + "B.one() + ':' + (Object.getPrototypeOf(B) === A)");
+    }
+
+    @Test
+    public void instanceAndStaticFields() {
+        check(3, "class A { x = 1; static y = 2; } new A().x + A.y");
+        check(
+                "1,2,undefined,3",
+                "class A { a = 1; b = this.a + 1; c; ['d'] = 3; }\n"
+                        + "var o = new A(); [o.a, o.b, o.c, o.d].map(String).join()");
+    }
+
+    @Test
+    public void fieldsRunBeforeBaseConstructorBody() {
+        check(
+                "1:2",
+                "class A { x = 1; constructor() { this.seen = this.x; this.x = 2; } }\n"
+                        + "var a = new A(); a.seen + ':' + a.x");
+    }
+
+    @Test
+    public void derivedFieldsRunAfterSuper() {
+        check(
+                "undefined:5",
+                "class A { constructor() { this.seen = this.y; } }\n"
+                        + "class B extends A { y = 5; }\n"
+                        + "var b = new B(); b.seen + ':' + b.y");
+    }
+
+    @Test
+    public void fieldArrowFunctionsBindThis() {
+        check(7, "class A { v = 7; get = () => this.v; } var g = new A().get; g()");
+    }
+
+    @Test
+    public void staticFieldsAndBlocks() {
+        check(
+                "1,2,A",
+                "class A { static a = 1; static { this.b = this.a + 1; } static c = this.name; }\n"
+                        + "[A.a, A.b, A.c].join()");
+    }
+
+    @Test
+    public void extendsBuiltIns() {
+        check(
+                "true,true,MyError,boom",
+                "class MyError extends Error {\n"
+                        + "  constructor(m) { super(m); this.name = 'MyError'; } }\n"
+                        + "var e = new MyError('boom');\n"
+                        + "[e instanceof MyError, e instanceof Error, e.name, e.message].join()");
+        check(
+                "3,true,1",
+                "class Stack extends Array { top() { return this[this.length - 1]; } }\n"
+                        + "var s = new Stack(); s.push(1, 2, 3);\n"
+                        + "[s.length, s instanceof Array, s.top() - 2].join()");
+        check(
+                "2,true",
+                "class Counter extends Map { inc(k) { this.set(k, (this.get(k) || 0) + 1); } }\n"
